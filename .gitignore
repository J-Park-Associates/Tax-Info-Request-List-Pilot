# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp

# Environment / secrets
.env
.env.local
*.key
credentials.json

# Dependencies / build
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

~$*

app/node_modules/

# Portable package build output (rebuild with "Build App.bat"). The
# lockfile and api_entry.spec are tracked: they are what makes it reproducible.
build-portable/

# The firm's own redacted documents and their expectations file live
# outside the repository (TRACKER_REAL_CORPUS names the folder). This is
# for the day someone drops them inside the tree anyway: redaction is a
# person's judgement, not a guarantee, and a client document in the repo
# is in every clone and every build.
real-corpus/

# Client-provided files are sensitive — never commit actual documents.
# Track only the manifest/metadata, not the files themselves.
client-files/**
!client-files/.gitkeep
!client-files/**/.gitkeep

# Accounting / working files
*.qbw
*.qbb
*.tlg

# The clients root's two trees and every file the tracker writes inside
# them (decision 176). A pass pointed at a copy of a client's folder made
# inside the checkout - to debug one household - leaves the record, the
# page, the README and what it took out of their emails there, each one
# `git add -A` away from every clone. tests/test_single_source.py names
# each from its constant.
Clients/
J Park & Associates/
_ledger.jsonl
_scan.lock
_readme.lock
_README.txt
Status Report.html
_Opened/

# Scheduled-run artifacts. Drafts quote real clients' outstanding documents,
# and the run log and the status page name them. None of it belongs in the
# repo: the log and the page live in the clients root, the drafts beside
# each engagement.
runs.log
status.html
# The clients root, written once by the app (or python -m tracker.settings).
settings.json
# The store (decision 101): one SQLite database beside the settings file,
# which in a source checkout is this folder. It is rebuilt from each
# engagement's own journal, so it is never worth committing - and it holds
# every client's index rows, so it must never be.
tracker.db
tracker.db-wal
tracker.db-shm
# OCR's temporary page images during a pass (decision 137, L7). Retired by
# decision 169 - the reader writes no temporary file - but a checkout that
# ran a pass before it may still hold the folder, with a client's page in
# it, so it stays ignored.
ocr-scratch/

# Tools' own working folders (decision 137): Claude Code's worktrees and
# settings, and the knowledge-graph tool's output, which quotes the tree.
.claude/
graphify-out/
tax-tracker.xml
reminder-draft.txt
reminder-draft.NEW.txt
reminder-draft.set-aside-*.txt
