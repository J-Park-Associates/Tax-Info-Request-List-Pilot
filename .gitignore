# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp

# Environment / secrets
.env
.env.local
*.key
credentials.json

# Dependencies / build
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Demo artifacts (script is tracked; its generated files are not)
demo/*.xlsx
demo/*.json
demo/Shared/
demo/*.log*
demo/*.lock
~$*

# Marketing demo: fully regenerated by "Reset Demo" / tracker.api reset
demo-marketing/
app/node_modules/
app/package-lock.json

# Portable package build output (rebuild with "Build Portable Demo.bat")
build-portable/
*.spec

# Client-provided files are sensitive — never commit actual documents.
# Track only the manifest/metadata, not the files themselves.
client-files/**
!client-files/.gitkeep
!client-files/**/.gitkeep

# Accounting / working files
*.qbw
*.qbb
*.tlg
~$*.xlsx
~$*.docx
