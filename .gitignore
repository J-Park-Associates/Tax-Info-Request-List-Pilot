# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp

# Environment / secrets
.env
.env.local
*.key
credentials.json

# Dependencies / build
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

~$*

app/node_modules/
app/package-lock.json

# Portable package build output (rebuild with "Build App.bat")
build-portable/
*.spec

# Client-provided files are sensitive — never commit actual documents.
# Track only the manifest/metadata, not the files themselves.
client-files/**
!client-files/.gitkeep
!client-files/**/.gitkeep

# Accounting / working files
*.qbw
*.qbb
*.tlg
~$*.xlsx
~$*.docx

# Scheduled-run artifacts. Drafts quote real clients' outstanding documents
# and the run log names them. Neither belongs in the repo — they live beside
# the client folders.
runs.log
# The clients root, written once by the app (or python -m tracker.settings).
settings.json
tax-tracker.xml
reminder-draft.txt
reminder-draft.NEW.txt
tax-tracker.xml
